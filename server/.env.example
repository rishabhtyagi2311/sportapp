DATABASE_URL="postgresql://admin:admin@127.0.0.1:5432/sportify?schema=public"
# Prisma defaults its connection pool size to (num_physical_cpus * 2 + 1)
# PER PrismaClient instance — i.e. per running server process. That's fine
# for a single instance, but once running more than one behind a load
# balancer (e.g. an ASG), total connections against Postgres scale linearly
# with instance count with no shared ceiling, which can exceed a managed
# Postgres plan's max_connections. Before scaling out, add explicit pool
# sizing to the URL, e.g.:
#   ?schema=public&connection_limit=<max_connections / planned_instance_count>&pool_timeout=20

JWT_SECRET="change_me"
JWT_EXPIRES_IN="7d"

# Background jobs (slot cleanup/generation, see src/index.ts) run in-process
# on a setInterval with no leader election. Safe on a single instance
# (default, no config needed). Once running more than one instance behind
# an ASG, set this to "false" on all but one designated instance so the
# daily cleanup/generation work isn't duplicated N times.
# RUN_BACKGROUND_JOBS="true"

# AWS S3 credentials for venue image uploads
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
